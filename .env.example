NODE_ENV=development
MYSQL_URL=mysql://lionsplus_user:replace-with-database-password@127.0.0.1:3306/lionsplus_db
# MYSQL_CA_CERT_BASE64 is only needed when the MySQL server requires a custom CA.
# MYSQL_CA_CERT_BASE64=base64-encoded-ca-certificate
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-initial-password
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-google-app-password
EMAIL_NOTIFY_TO=bookings@example.com
CLIENT_ORIGIN=http://localhost:5173
PORT=8787
